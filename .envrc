# direnv: per-project Cloudflare account pin.
#
# WHY THIS EXISTS
# There are at least four Cloudflare accounts across the projects in this workspace, and
# `wrangler login` is GLOBAL — it writes one credential file for the whole machine, so
# logging in for one project silently repoints every other project. Pinning the account
# here means a wrangler command run from this directory either targets the right account
# or fails loudly; it can never quietly deploy Sikh World Championship somewhere else.
#
# Verified behaviour: with the wrong account pinned, wrangler refuses with
#   ✘ ERROR  A request to the Cloudflare API (/accounts/…) failed.
#            Authentication error [code: 10000]
# which is exactly the failure mode you want.
#
# Requires direnv (already installed and hooked into ~/.zshrc). Run `direnv allow` once
# after changing this file.

# media@shaheedibunga.com — verified 2026-08-27 via `wrangler whoami`.
# An account ID is an identifier, not a credential; Cloudflare's own docs put it in
# committed config. Real secrets go in .envrc.local, which is gitignored.
export CLOUDFLARE_ACCOUNT_ID=c1b50ea317dc2bbd5fdff7d6d9a3e8d9

# Optional upgrade: a project-scoped API token makes this directory completely independent
# of whatever `wrangler login` last touched, so another project's login cannot affect it.
# See .envrc.local.example. Nothing breaks without it — the account pin above still holds.
source_env_if_exists .envrc.local

if [ -z "${CLOUDFLARE_API_TOKEN:-}" ]; then
  echo "direnv: SWC → Cloudflare account pinned. Identity still comes from the global"
  echo "        'wrangler login' — run 'wrangler whoami' before deploying, or set up"
  echo "        .envrc.local (see .envrc.local.example) to stop depending on it."
fi

# Deliberately NOT setting XDG_CONFIG_HOME here.
# It does isolate wrangler's credentials per-project — tested and it works — but it also
# redirects every other XDG-respecting tool, including `gh`, which would lose its auth in
# this directory. A scoped API token achieves the same isolation with no collateral damage.
#
# Deliberately NOT setting NEXT_PUBLIC_SITE_URL here either. It is baked into the build,
# and a shell-level default of localhost would silently ship guardian approval links
# pointing at localhost. That belongs in .env.local or the Cloudflare dashboard.
