# Sikh World Championship — local environment
#
# Copy to .env.local. Every variable here has a working default, so the app runs with
# no .env.local at all. .env.local is gitignored and must stay that way.

# Public base URL. NO LONGER NEEDED for local work, and left here only for a staging
# deploy on its own domain. Links in emails and sign-in redirects now come from the
# request itself (src/lib/site-url.ts), which is what makes a magic link generated on a
# laptop point at that laptop. Setting this overrides that everywhere.
# NEXT_PUBLIC_SITE_URL=https://staging.example

# Where the development JSON stores are written. Defaults to ./.data
# The test suite overrides this with a temp directory so running tests never wipes data.
# SWC_DATA_DIR=./.data

# Send email for real from `next dev`. Off by default: the key is loaded from the Keychain
# by .envrc, so a laptop can reach the live Resend account, and a rehearsal would put a
# real guardian notice in a real inbox. Unset, every email is printed to the terminal
# instead and recorded as a failed send. See src/lib/email.ts.
# SWC_EMAIL_DEV_SEND=true

# Moderator access is a database grant, not an environment variable. The stub that this
# variable used to drive is gone — see setModerator() in src/lib/players.ts.
#   npx wrangler d1 execute swc-production --remote \
#     --command "UPDATE players SET is_moderator = 1 WHERE email = 'them@example.com'"

# ---------------------------------------------------------------------------
# Not wired up yet — listed so the shape is known before the migration starts.
# See 00_Docs/DATA-LAYER.md and 00_Docs/NEXT-STEPS.md.
# ---------------------------------------------------------------------------

# Database (replaces the JSON stores; needed for encryption at rest and concurrency)
# NEXT_PUBLIC_SUPABASE_URL=
# NEXT_PUBLIC_SUPABASE_ANON_KEY=
# SUPABASE_SERVICE_ROLE_KEY=          # server only — never expose to the browser

# Transactional email. src/lib/notify.ts only console.logs today, which means the
# guardian notification promised on /safeguarding does not actually send. This is the
# blocking item before under-16 board access is switched on for real players.
# RESEND_API_KEY=
# MAIL_FROM="Sikh World Championship <no-reply@sikhworldchampionship.com>"
